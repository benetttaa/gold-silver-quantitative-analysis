        "def band_position(price, lower, ma, upper):\n",
        "    if price < lower:\n",
        "        return \"Below lower band\"\n",
        "    elif price > upper:\n",
        "        return \"Above upper band\"\n",
        "    else:\n",
        "        return \"Within bands\"\n",
        "\n",
        "\n",
        "gold_position = band_position(\n",
        "    gold.iloc[-1],\n",
        "    gold_lower.iloc[-1],\n",
        "    gold_ma.iloc[-1],\n",
        "    gold_upper.iloc[-1]\n",
        ")\n",
        "\n",
        "silver_position = band_position(\n",
        "    silver.iloc[-1],\n",
        "    silver_lower.iloc[-1],\n",
        "    silver_ma.iloc[-1],\n",
        "    silver_upper.iloc[-1]\n",
        ")\n",
        "\n",
        "print(f\"Gold: {gold_position}\")\n",
        "print(f\"Silver: {silver_position}\")"
      ]
