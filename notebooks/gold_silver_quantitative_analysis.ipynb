    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vRKlsZJZ_Inw"
      },
      "outputs": [],
      "source": [
        "gold_deviation = ((gold - gold_ma) / gold_ma) * 100\n",
        "silver_deviation = ((silver - silver_ma) / silver_ma) * 100\n",
        "\n",
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    gold_deviation.index,\n",
        "    gold_deviation,\n",
        "    label=\"Gold\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    silver_drawdown.index,\n",
        "    silver_drawdown * 100,\n",
        "    label=\"Silver\"\n",
        ")\n",
        "\n",
        "ax.axhline(0, linestyle=\"--\")\n",
        "\n",
        "ax.set_title(\"Deviation from 200-Day Moving Average\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Deviation (%)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"trend_deviation.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
