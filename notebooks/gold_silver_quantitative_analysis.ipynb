        "def get_current_regime(volatility):\n",
        "    current_vol = volatility.dropna().iloc[-1]\n",
        "\n",
        "    q33 = volatility.dropna().quantile(0.33)\n",
        "    q67 = volatility.dropna().quantile(0.67)\n",
        "\n",
        "    if current_vol < q33:\n",
        "        return \"Low\"\n",
        "    elif current_vol <= q67:\n",
        "        return \"Medium\"\n",
        "    else:\n",
        "        return \"High\"\n",
        "\n",
        "\n",
        "gold_current_regime = get_current_regime(gold_volatility)\n",
        "silver_current_regime = get_current_regime(silver_volatility)\n",
        "\n",
        "gold_current_deviation = gold_deviation.dropna().iloc[-1]\n",
        "silver_current_deviation = silver_deviation.dropna().iloc[-1]\n",
        "\n",
        "snapshot = pd.DataFrame({\n",
        "    \"Metric\": [\n",
        "        \"Current Price\",\n",
        "        \"200-Day MA\",\n",
        "        \"Deviation from 200-Day MA\",\n",
        "        \"Annualized Volatility\",\n",
        "        \"Volatility Regime\",\n",
        "        \"Maximum Drawdown\"\n",
        "    ],\n",
        "    \"Gold\": [\n",
        "        f\"₹{gold.iloc[-1]:,.2f}\",\n",
        "        f\"₹{gold_ma.iloc[-1]:,.2f}\",\n",
        "        f\"{gold_current_deviation:.2f}%\",\n",
        "        f\"{gold_volatility.iloc[-1]:.2%}\",\n",
        "        gold_current_regime,\n",
        "        f\"{gold_drawdown.min():.2%}\"\n",
        "    ],\n",
        "    \"Silver\": [\n",
        "        f\"₹{silver.iloc[-1]:,.2f}\",\n",
        "        f\"₹{silver_ma.iloc[-1]:,.2f}\",\n",
        "        f\"{silver_current_deviation:.2f}%\",\n",
        "        f\"{silver_volatility.iloc[-1]:.2%}\",\n",
        "        silver_current_regime,\n",
        "        f\"{silver_drawdown.min():.2%}\"\n",
        "    ]\n",
        "})\n",
        "\n",
        "snapshot"
      ]
