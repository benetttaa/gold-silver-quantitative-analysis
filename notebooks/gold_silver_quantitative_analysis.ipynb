        "\n",
        "ax.plot(\n",
        "    silver_upper.index,\n",
        "    silver_upper,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Upper Band (+2σ)\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    silver_lower.index,\n",
        "    silver_lower,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Lower Band (-2σ)\"\n",
        ")\n",
        "\n",
        "ax.fill_between(\n",
        "    silver.index,\n",
        "    silver_lower,\n",
