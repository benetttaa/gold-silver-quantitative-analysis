      },
      "source": [
        "## Quantitative Gold & Silver Analysis\n",
        "\n",
        "## Time-Series Risk, Volatility Regimes & Trend Deviation\n",
        "\n",
        "This project analyzes the historical price behavior of Gold and Silver using\n",
        "daily market data from 2014 to the latest available date.\n",
        "\n",
        "The analysis focuses on:\n",
        "\n",
        "- Daily and cumulative returns\n",
        "- Rolling annualized volatility\n",
        "- Historical drawdowns\n",
        "- Long-term price trends\n",
        "- Trend-based ±2σ price bands\n",
        "- Deviation from long-term trend\n",
        "- Volatility regimes\n",
        "- Gold–Silver return correlation\n",
        "- Gold/Silver ratio\n",
        "\n",
        "The objective is to understand how Gold and Silver have behaved across\n",
        "different market conditions and quantify their risk and deviation from\n",
        "long-term trends.\n",
        "\n",
        "> **Note:** Gold and Silver prices are obtained from Yahoo Finance futures\n",
        "> series and converted from USD to INR using the USD/INR exchange rate.\n",
        "> The resulting prices represent INR equivalents of the Yahoo Finance\n",
        "> quoted futures prices and should not be interpreted as MCX retail/unit prices."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "TX8Av61e9NiM"
      },
      "outputs": [],
      "source": [
        "import yfinance as yf\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "from pathlib import Path\n",
        "import warnings\n",
        "\n",
        "warnings.filterwarnings(\"ignore\")\n",
        "\n",
        "plt.rcParams[\"figure.figsize\"] = (12, 6)\n",
        "plt.rcParams[\"axes.grid\"] = True\n",
        "plt.rcParams[\"figure.dpi\"] = 120"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "A16Qcvr-9rJx"
      },
      "outputs": [],
      "source": [
        "START_DATE = \"2014-01-01\"\n",
        "\n",
        "TRADING_DAYS = 252\n",
        "TREND_WINDOW = 200\n",
        "VOL_WINDOW = 252\n",
        "BAND_STD = 2\n",
        "\n",
        "OUTPUT_DIR = Path(\"results\")\n",
        "FIGURE_DIR = OUTPUT_DIR / \"figures\"\n",
        "\n",
        "FIGURE_DIR.mkdir(parents=True, exist_ok=True)"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "vHzNGWqf95qm"
      },
      "outputs": [],
      "source": [
        "def get_price_series(df):\n",
        "    \"\"\"\n",
        "    Extract the adjusted or closing price from Yahoo Finance output.\n",
        "    Handles both single-level and multi-level column structures.\n",
        "    \"\"\"\n",
        "    if isinstance(df.columns, pd.MultiIndex):\n",
        "        for col in [\"Adj Close\", \"Close\"]:\n",
        "            if col in df.columns.get_level_values(0):\n",
        "                result = df[col]\n",
        "                if isinstance(result, pd.DataFrame):\n",
        "                    result = result.iloc[:, 0]\n",
        "                return result\n",
        "\n",
        "    else:\n",
        "        for col in [\"Adj Close\", \"Close\"]:\n",
        "            if col in df.columns:\n",
        "                return df[col]\n",
        "\n",
        "    raise KeyError(\"No usable price column found.\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "NoWy98Z497eC"
      },
      "outputs": [],
      "source": [
        "gold_raw = yf.download(\n",
        "    \"GC=F\",\n",
        "    start=START_DATE,\n",
        "    progress=False,\n",
        "    auto_adjust=False\n",
        ")\n",
        "\n",
        "silver_raw = yf.download(\n",
        "    \"SI=F\",\n",
        "    start=START_DATE,\n",
        "    progress=False,\n",
        "    auto_adjust=False\n",
        ")\n",
        "\n",
        "usdinr_raw = yf.download(\n",
        "    \"INR=X\",\n",
        "    start=START_DATE,\n",
        "    progress=False,\n",
        "    auto_adjust=False\n",
        ")\n",
        "\n",
        "gold_usd = get_price_series(gold_raw)\n",
        "silver_usd = get_price_series(silver_raw)\n",
        "usd_inr = get_price_series(usdinr_raw)\n",
        "\n",
        "data = pd.concat(\n",
        "    [gold_usd, silver_usd, usd_inr],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "data.columns = [\"Gold_USD\", \"Silver_USD\", \"USD_INR\"]\n",
        "\n",
        "data = data.sort_index()\n",
        "data = data.ffill().dropna()\n",
        "\n",
        "data.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "oyPk3An4-Bhp"
      },
      "outputs": [],
      "source": [
        "data[\"Gold_INR\"] = data[\"Gold_USD\"] * data[\"USD_INR\"]\n",
        "data[\"Silver_INR\"] = data[\"Silver_USD\"] * data[\"USD_INR\"]\n",
        "\n",
        "gold = data[\"Gold_INR\"]\n",
        "silver = data[\"Silver_INR\"]\n",
        "\n",
        "print(f\"Analysis period: {data.index.min().date()} to {data.index.max().date()}\")\n",
        "print(f\"Observations: {len(data):,}\")\n",
        "print(f\"Latest Gold price: ₹{gold.iloc[-1]:,.2f}\")\n",
        "print(f\"Latest Silver price: ₹{silver.iloc[-1]:,.2f}\")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "ByWW4See-BtI"
      },
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(gold.index, gold, label=\"Gold\")\n",
        "ax.plot(silver.index, silver, label=\"Silver\")\n",
        "\n",
        "ax.set_title(\"Gold and Silver Prices in INR\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"INR per quoted futures unit\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"gold_silver_prices.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "##  Return Analysis\n",
        "\n",
        "Daily returns measure the percentage change in price from one trading day\n",
        "to the next:\n",
        "\n",
        "$$\n",
        "R_t = \\frac{P_t-P_{t-1}}{P_{t-1}}\n",
        "$$\n",
        "\n",
        "Returns provide a normalized basis for comparing the behavior and risk of\n",
        "Gold and Silver over time."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "zK9VeXw1-HBQ"
      },
      "outputs": [],
      "source": [
        "gold_returns = gold.pct_change().dropna()\n",
        "silver_returns = silver.pct_change().dropna()\n",
        "\n",
        "returns = pd.concat(\n",
        "    [gold_returns, silver_returns],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "returns.columns = [\"Gold\", \"Silver\"]\n",
        "\n",
        "returns.head()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "IZ0eZoik-HLv"
      },
      "outputs": [],
      "source": [
        "gold_cumulative = (1 + gold_returns).cumprod() - 1\n",
        "silver_cumulative = (1 + silver_returns).cumprod() - 1\n",
        "\n",
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(gold_cumulative.index, gold_cumulative * 100, label=\"Gold\")\n",
        "ax.plot(silver_cumulative.index, silver_cumulative * 100, label=\"Silver\")\n",
        "\n",
        "ax.set_title(\"Cumulative Returns: Gold vs Silver\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Cumulative Return (%)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"cumulative_returns.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Rolling Volatility\n",
        "\n",
        "Volatility measures the dispersion of returns.\n",
        "\n",
        "A 252-day rolling standard deviation is used to estimate one-year realized\n",
        "volatility. It is annualized using:\n",
        "\n",
        "$$\n",
        "\\sigma_{annual} = \\sigma_{daily}\\sqrt{252}\n",
        "$$\n",
        "\n",
        "252 trading days is used as an approximation for one trading year."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "gold_volatility = (\n",
        "    gold_returns.rolling(VOL_WINDOW).std()\n",
        "    * np.sqrt(TRADING_DAYS)\n",
        ")\n",
        "\n",
        "silver_volatility = (\n",
        "    silver_returns.rolling(VOL_WINDOW).std()\n",
        "    * np.sqrt(TRADING_DAYS)\n",
        ")"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {},
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    gold_volatility.index,\n",
        "    gold_volatility * 100,\n",
        "    label=\"Gold\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    silver_volatility.index,\n",
        "    silver_volatility * 100,\n",
        "    label=\"Silver\"\n",
        ")\n",
        "\n",
        "ax.set_title(\"252-Day Rolling Annualized Volatility\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Annualized Volatility (%)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "\n",
        "plt.savefig(\n",
        "    FIGURE_DIR / \"rolling_volatility.png\",\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Volatility Regimes\n",
        "\n",
        "To identify periods of relatively low or high realized volatility, rolling\n",
        "volatility is classified using its historical percentile distribution.\n",
        "\n",
        "- Low: below the 33rd percentile\n",
        "- Medium: 33rd–67th percentile\n",
        "- High: above the 67th percentile\n",
        "\n",
        "These regimes are descriptive and are not intended as predictive signals."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "0IyNNJYu-HVN"
      },
      "outputs": [],
      "source": [
        "def classify_volatility(volatility):\n",
        "    q33 = volatility.quantile(0.33)\n",
        "    q67 = volatility.quantile(0.67)\n",
        "\n",
        "    regime = pd.Series(index=volatility.index, dtype=\"object\")\n",
        "\n",
        "    regime[volatility < q33] = \"Low\"\n",
        "    regime[(volatility >= q33) & (volatility <= q67)] = \"Medium\"\n",
        "    regime[volatility > q67] = \"High\"\n",
        "\n",
        "    return regime"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "lJpowodc-RxP"
      },
      "outputs": [],
      "source": [
        "gold_regime = classify_volatility(gold_volatility.dropna())\n",
        "silver_regime = classify_volatility(silver_volatility.dropna())\n",
        "\n",
        "gold_regime_counts = gold_regime.value_counts(normalize=True) * 100\n",
        "silver_regime_counts = silver_regime.value_counts(normalize=True) * 100\n",
        "\n",
        "regime_summary = pd.DataFrame({\n",
        "    \"Gold (%)\": gold_regime_counts,\n",
        "    \"Silver (%)\": silver_regime_counts\n",
        "}).reindex([\"Low\", \"Medium\", \"High\"])\n",
        "\n",
        "regime_summary"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "6pdlOebN-R9v"
      },
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    gold_regime.index,\n",
        "    gold_volatility.loc[gold_regime.index] * 100,\n",
        "    label=\"Gold\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    silver_regime.index,\n",
        "    silver_volatility.loc[silver_regime.index] * 100,\n",
        "    label=\"Silver\"\n",
        ")\n",
        "\n",
        "ax.set_title(\"Rolling Volatility: Gold vs Silver\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Annualized Volatility (%)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"volatility_regimes.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "X2pHPaXa-vSA"
      },
      "outputs": [],
      "source": [
        "gold_high_vol_threshold = gold_volatility.quantile(0.90)\n",
        "silver_high_vol_threshold = silver_volatility.quantile(0.90)\n",
        "\n",
        "gold_high_vol_periods = gold_volatility[\n",
        "    gold_volatility >= gold_high_vol_threshold\n",
        "]\n",
        "\n",
        "silver_high_vol_periods = silver_volatility[\n",
        "    silver_volatility >= silver_high_vol_threshold\n",
        "]\n",
        "\n",
        "print(\n",
        "    f\"Gold 90th percentile volatility threshold: \"\n",
        "    f\"{gold_high_vol_threshold:.2%}\"\n",
        ")\n",
        "\n",
        "print(\n",
        "    f\"Silver 90th percentile volatility threshold: \"\n",
        "    f\"{silver_high_vol_threshold:.2%}\"\n",
        ")"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Drawdown Analysis\n",
        "\n",
        "Drawdown measures the decline in price from a previous running maximum:\n",
        "\n",
        "$$\n",
        "Drawdown_t =\n",
        "\\frac{P_t}{\\max(P_1,\\ldots,P_t)}-1\n",
        "$$\n",
        "\n",
        "Maximum drawdown captures the largest peak-to-trough decline observed\n",
        "during the analysis period."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "hGH2iq3w-ve9"
      },
      "outputs": [],
      "source": [
        "def calculate_drawdown(price):\n",
        "    running_max = price.cummax()\n",
        "    return price / running_max - 1\n",
        "\n",
        "\n",
        "gold_drawdown = calculate_drawdown(gold)\n",
        "silver_drawdown = calculate_drawdown(silver)\n",
        "\n",
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    gold_drawdown.index,\n",
        "    gold_drawdown * 100,\n",
        "    label=\"Gold\"\n",
        ")\n",
        "\n",
        "ax.plot(\n        "    silver_drawdown.index,\n",
        "    silver_drawdown * 100,\n",
        "    label=\"Silver\"\n",
        ")\n",
        "\n",
        "ax.set_title(\"Historical Drawdowns\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Drawdown (%)\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"drawdowns.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Long-Term Trend and Price Bands\n",
        "\n",
        "A 200-day moving average is used as the long-term trend measure.\n",
        "\n",
        "To quantify deviations from this trend, price bands are constructed using\n",
        "the rolling 200-day standard deviation:\n",
        "\n",
        "$$\n",
        "Upper_t = MA_{200,t} + 2\\sigma_{200,t}\n",
        "$$\n",
        "\n",
        "$$\n",
        "Lower_t = MA_{200,t} - 2\\sigma_{200,t}\n",
        "$$\n",
        "\n",
        "The bands provide a statistical reference for identifying unusually large\n",
        "deviations from the long-term price trend.\n",
        "\n",
        "A price crossing a band does not by itself represent a trading signal."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "CucoGoQr-vrB"
      },
      "outputs": [],
      "source": [
        "gold_ma = gold.rolling(TREND_WINDOW).mean()\n",
        "silver_ma = silver.rolling(TREND_WINDOW).mean()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "XXvv_bgK-_E6"
      },
      "outputs": [],
      "source": [
        "gold_price_std = gold.rolling(TREND_WINDOW).std()\n",
        "silver_price_std = silver.rolling(TREND_WINDOW).std()\n",
        "\n",
        "gold_upper = gold_ma + BAND_STD * gold_price_std\n",
        "gold_lower = gold_ma - BAND_STD * gold_price_std\n",
        "\n",
        "silver_upper = silver_ma + BAND_STD * silver_price_std\n",
        "silver_lower = silver_ma - BAND_STD * silver_price_std"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "THHmDNX5_AQb"
      },
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    gold.index,\n",
        "    gold,\n",
        "    label=\"Gold Price\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    gold_ma.index,\n",
        "    gold_ma,\n",
        "    label=\"200-Day MA\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    gold_upper.index,\n",
        "    gold_upper,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Upper Band (+2σ)\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
        "    gold_lower.index,\n",
        "    gold_lower,\n",
        "    linestyle=\"--\",\n",
        "    label=\"Lower Band (-2σ)\"\n",
        ")\n",
        "\n",
        "ax.fill_between(\n",
        "    gold.index,\n",
        "    gold_lower,\n",
        "    gold_upper,\n",
        "    alpha=0.15\n",
        ")\n",
        "\n",
        "ax.set_title(\"Gold Price with 200-Day Trend and ±2σ Bands\")\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"INR per quoted futures unit\")\n",
        "ax.legend()\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.savefig(FIGURE_DIR / \"gold_price_bands.png\", bbox_inches=\"tight\")\n",
        "plt.show()"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "38ZNOPTS_HAF"
      },
      "outputs": [],
      "source": [
        "fig, ax = plt.subplots()\n",
        "\n",
        "ax.plot(\n",
        "    silver.index,\n",
        "    silver,\n",
        "    label=\"Silver Price\"\n",
        ")\n",
        "\n",
        "ax.plot(\n",
