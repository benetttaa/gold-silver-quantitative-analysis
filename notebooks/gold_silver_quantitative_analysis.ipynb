      "outputs": [],
      "source": [
        "def calculate_metrics(price, returns, volatility, drawdown):\n",
        "    annualized_mean_return = returns.mean() * TRADING_DAYS\n",
        "    annualized_volatility = returns.std() * np.sqrt(TRADING_DAYS)\n",
        "\n",
        "    sharpe = (\n",
        "        annualized_mean_return / annualized_volatility\n",
        "        if annualized_volatility != 0 else np.nan\n",
        "    )\n",
        "\n",
        "    return {\n",
        "        \"Mean Daily Return\": returns.mean(),\n",
        "        \"Annualized Mean Return\": annualized_mean_return,\n",
        "        \"Annualized Volatility\": annualized_volatility,\n",
        "        \"Sharpe Ratio (Rf=0)\": sharpe,\n",
        "        \"Maximum Drawdown\": drawdown.min(),\n",
        "        \"Skewness\": returns.skew(),\n",
        "        \"Excess Kurtosis\": returns.kurtosis(),\n",
        "        \"Best 30-Day Return\": price.pct_change(30).max(),\n",
        "        \"Worst 30-Day Return\": price.pct_change(30).min()\n",
        "    }\n",
        "\n",
        "\n",
        "gold_metrics = calculate_metrics(\n",
        "    gold,\n",
        "    gold_returns,\n",
        "    gold_volatility,\n",
        "    gold_drawdown\n",
        ")\n",
        "\n",
        "silver_metrics = calculate_metrics(\n",
        "    silver,\n",
        "    silver_returns,\n",
        "    silver_volatility,\n",
        "    silver_drawdown\n",
        ")\n",
        "\n",
        "metrics_table = pd.DataFrame({\n",
        "    \"Gold\": gold_metrics,\n",
        "    \"Silver\": silver_metrics\n",
        "})\n",
        "\n",
        "metrics_table"
      ]
    },
